[Desktop Entry]
Type=Application
Name=Linux Google Chat – icon theme sync
Comment=Switches the app icon between dark and light with the system theme, also while the app is closed
Exec=linux-google-chat --icon-sync-watch
TryExec=linux-google-chat
NoDisplay=true
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=3
