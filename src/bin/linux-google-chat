#!/usr/bin/python3
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
for cand in (os.path.join(HERE, "..", "src"), "/usr/share/linux-google-chat/src"):
    if os.path.isdir(os.path.join(cand, "lgc")):
        sys.path.insert(0, os.path.abspath(cand))
        break

if __name__ == "__main__":
    if "--icon-sync-watch" in sys.argv:
        from lgc import desktop
        desktop.watch()
    elif "--icon-sync" in sys.argv:
        from lgc import desktop
        print(desktop.apply_icon())
    elif "--version" in sys.argv:
        from lgc import VERSION
        print(VERSION)
    else:
        from lgc.app import main
        sys.exit(main())
